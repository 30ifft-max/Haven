<%# locals: (tag:) %>

<div id="<%= dom_id(tag) %>" class="flex min-h-14 items-center justify-between gap-3 px-4 hover:bg-container-inset">
  <div class="flex min-w-0 flex-1 items-center gap-2.5">
    <p class="text-primary text-sm truncate">
      <%= render partial: "tags/badge", locals: { tag: tag } %>
    </p>
    <span class="shrink-0 text-sm tabular-nums text-secondary" data-testid="tag-usage-count">
      <span class="text-subdued">&middot;</span>
      <%= tag.usage_count %>
    </span>
  </div>
  <div class="justify-self-end">
    <%= render DS::Menu.new do |menu| %>
      <% menu.with_item(variant: "link", text: t(".edit"), href: edit_tag_path(tag), icon: "pencil", data: { turbo_frame: "modal" }) %>

      <% if tag.usage_count.positive? %>
        <% menu.with_item(
          variant: "link",
          text: t(".delete"),
          href: new_tag_deletion_path(tag),
          icon: "trash-2",
          frame: :modal
        ) %>
      <% else %>
        <% menu.with_item(
          variant: "button",
          text: t(".delete"),
          href: tag_path(tag),
          icon: "trash-2",
          method: :delete,
          confirm: CustomConfirm.for_resource_deletion(tag.name)
        ) %>
      <% end %>
    <% end %>
  </div>
</div>
