<%# locals: (form:) %>

<%= render DS::Tabs.new(
  variant: :unstyled,
  active_tab: get_default_transaction_search_filter[:key],
  active_btn_classes: "bg-surface text-primary",
  inactive_btn_classes: "text-secondary hover:bg-container-inset"
) do |tabs| %>
  <div id="transaction-filters-menu"
       class="flex h-[440px] w-full md:w-[720px] overflow-hidden"
       data-controller="transaction-filter-menu"
       data-transaction-filter-menu-remove-label-value="<%= t("transactions.searches.menu.remove_condition") %>"
       data-action="change->transaction-filter-menu#updateSelected input->transaction-filter-menu#updateSelected click->transaction-filter-menu#focusSearch">
    <%= tabs.with_nav(classes: "flex w-24 shrink-0 flex-col items-stretch border-r border-secondary p-2 text-sm font-medium") do |nav| %>
      <% transaction_search_filters.each do |filter| %>
        <% nav.with_btn(id: filter[:key], label: filter[:label], classes: "w-full justify-start px-3 py-2") %>
      <% end %>
    <% end %>

    <div class="flex min-w-0 w-72 shrink-0 flex-col border-r border-secondary">
      <div class="grow overflow-y-auto p-3">
        <% transaction_search_filters.each do |filter| %>
          <%= tabs.with_panel(tab_id: filter[:key]) do %>
            <%= render partial: get_transaction_search_filter_partial_path(filter), locals: { form: form } %>
          <% end %>
        <% end %>
      </div>

    </div>

    <div class="flex min-w-0 flex-1 flex-col">
      <div class="grow overflow-y-auto p-4">
        <div class="mb-3 flex items-center justify-between gap-2">
          <p class="text-sm font-medium text-primary"><%= t("transactions.searches.menu.selected_conditions") %></p>
          <% normalized_query = @q.to_h.stringify_keys %>
          <% if normalized_query.except("start_date", "end_date", "search").present? %>
            <% preserved_query = normalized_query.slice("start_date", "end_date", "search") %>
            <%= render DS::Link.new(
                  text: t(".clear_filters"),
                  variant: "outline",
                  size: "sm",
                  href: transactions_path(clear_filters: true, q: preserved_query)
                ) %>
          <% end %>
        </div>
        <p class="text-sm text-secondary" data-transaction-filter-menu-target="empty"><%= t("transactions.searches.menu.no_conditions") %></p>
        <div class="space-y-2" data-transaction-filter-menu-target="selected"></div>
      </div>

      <div class="flex justify-end border-t border-secondary p-3">
        <%= render DS::Button.new(text: t(".apply"), type: :submit) %>
      </div>
    </div>
  </div>
<% end %>
