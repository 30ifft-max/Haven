<%= form_with url: transactions_path,
              id: "transactions-search",
              scope: :q,
              method: :get,
              data: { controller: "auto-submit-form" } do |form| %>
  <%= hidden_field_tag :per_page, params[:per_page] %>

  <div class="flex justify-end gap-2 mb-4">
    <% if @q.present? %>
      <%= link_to "清除", transactions_path(clear_filters: true), class: "inline-flex items-center px-2 text-base font-semibold text-link no-underline hover:no-underline whitespace-nowrap" %>
    <% end %>
    <div class="w-full max-w-[400px] min-w-0 shrink">
      <% if @q[:search].present? %>
        <div class="relative ml-auto w-[250px]">
          <%= form.text_field :search, value: @q[:search], placeholder: "搜索", class: "form-field__input w-full rounded-lg border border-secondary bg-surface-inset px-3 py-2 pr-8", "data-auto-submit-form-target": "auto" %>
          <%= button_tag "×", type: "submit", name: "q[search]", value: "", class: "absolute right-2 top-1/2 -translate-y-1/2 flex size-5 items-center justify-center rounded-full text-secondary hover:bg-surface-hover", aria: { label: t("transactions.searches.form.clear_search", default: "清除搜索") } %>
        </div>
      <% else %>
        <details class="group relative ml-auto w-fit open:w-[250px]" data-controller="collapsible-search">
          <summary class="list-none cursor-pointer font-medium whitespace-nowrap inline-flex items-center gap-1 rounded-lg px-3 py-2 text-sm text-primary border border-secondary hover:bg-surface-hover group-open:hidden">
            <%= icon("search") %>
            <span>搜索</span>
          </summary>
          <div class="absolute right-0 top-0 hidden w-[250px] group-open:block">
            <%= form.text_field :search, autofocus: true, placeholder: "搜索", class: "form-field__input w-full rounded-lg border border-secondary bg-surface-inset px-3 py-2", "data-auto-submit-form-target": "auto" %>
          </div>
        </details>
      <% end %>
    </div>

    <%= render DS::Popover.new(variant: "button", no_padding: true, placement: "bottom-start") do |popover| %>
      <% popover.with_button(
        id: "transaction-date-button",
        type: "button",
        text: transaction_date_range_label(@q[:start_date], @q[:end_date]) || t("transactions.searches.menu.date_filter"),
        variant: "outline",
        icon: "calendar",
        class: "[&>span]:hidden lg:[&>span]:inline-flex #{"relative after:absolute after:-right-1 after:-top-1 after:size-2 after:rounded-full after:bg-red-500" if @q[:start_date].present? || @q[:end_date].present?}",
        data: { transaction_date_filter_target: "button", default_label: t("transactions.searches.menu.date_filter") }
      ) %>

      <% popover.with_custom_content do %>
        <%= render "transactions/searches/date_menu", form: form %>
      <% end %>
    <% end %>

    <%= render DS::Popover.new(variant: "button", no_padding: true) do |popover| %>
      <% popover.with_button(
        id: "transaction-filters-button",
        type: "button",
        text: t(".filter"),
        variant: "outline",
        icon: "list-filter",
        class: "[&>span]:hidden lg:[&>span]:inline-flex #{"relative after:absolute after:-right-1 after:-top-1 after:size-2 after:rounded-full after:bg-red-500" if @q.except("start_date", "end_date", "search").present?}"
      ) %>

      <% popover.with_custom_content do %>
        <%= render "transactions/searches/menu", form: form %>
      <% end %>
    <% end %>

  </div>
<% end %>
