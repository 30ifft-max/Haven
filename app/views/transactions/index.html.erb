<div class="haven-transaction-log relative pb-6 lg:pb-12 flex flex-col [&_turbo-frame:focus]:outline-none [&_turbo-frame:focus]:ring-0 [&_turbo-frame:focus-visible]:outline-none [&_turbo-frame:focus-visible]:ring-0" data-controller="overview-toggle checkbox-toggle">
  <header class="absolute right-0 top-0 z-10 flex items-center text-primary font-medium">
    <div class="flex items-center gap-2">
        <%= render DS::Menu.new do |menu| %>
          <% menu.with_item(variant: "link", text: t(".new_rule"), href: new_rule_path(resource_type: "transaction"), icon: "plus", data: { turbo_frame: :modal }) %>
          <% menu.with_item(variant: "link", text: t(".edit_rules"), href: rules_path, icon: "git-branch", data: { turbo_frame: :_top }) %>
          <% menu.with_item(variant: "link", text: t(".edit_categories"), href: categories_path, icon: "shapes", data: { turbo_frame: :_top }) %>
          <% menu.with_item(variant: "link", text: t(".edit_tags"), href: tags_path, icon: "tags", data: { turbo_frame: :_top }) %>
          <% menu.with_item(variant: "link", text: t(".edit_merchants"), href: family_merchants_path, icon: "store", data: { turbo_frame: :_top }) %>
          <% menu.with_item(variant: "link", text: t(".edit_imports"), href: imports_path, icon: "hard-drive-upload", data: { turbo_frame: :_top }) %>
          <% menu.with_item(variant: "link", text: t(".import"), href: new_import_path, icon: "download", data: { turbo_frame: "modal", class_name: "md:!hidden" }) %>
          <% if @uncategorized_count > 0 %>
            <% menu.with_item(variant: "link", text: t(".categorize_button", count: @uncategorized_count), href: transactions_categorize_path, icon: "tag", data: { turbo_frame: :_top }) %>
          <% end %>
        <% end %>

        <%= render DS::Link.new(
            text: t(".new_transaction"),
            icon: "plus",
            variant: "primary",
            href: new_transaction_path,
            frame: :modal,
            class: "hidden md:inline-flex"
          ) %>

        <%= render DS::Link.new(
            icon: "plus",
            variant: "icon-inverse",
            href: new_transaction_path,
            frame: :modal,
            class: "rounded-full md:hidden"
          ) %>
    </div>
  </header>

  <% if Current.family.recurring_transactions_disabled? %>
    <div class="mt-12 mb-4 flex flex-wrap items-start justify-between gap-3 [&_#transaction-search-filters]:mb-0 [&_#transactions-search>div]:mb-0">
      <div class="flex shrink-0 items-center gap-2">
        <%= render DS::Button.new(id: "toggle-checkboxes-button", text: t("transactions.searches.form.select", default: "选择"), type: "button", variant: "outline", icon: "list-todo", class: "[&>span]:hidden lg:[&>span]:inline-flex", data: { action: "click->checkbox-toggle#toggle", checkbox_toggle_target: "toggleButton" }) %>
        <%= render DS::Button.new(id: "transaction-summary-button", text: t("transactions.show.summary", default: "概览"), type: "button", variant: "outline", icon: "chart-no-axes-column", class: "[&>span]:hidden lg:[&>span]:inline-flex", aria: { controls: "transaction-summary", expanded: "false" }, data: { action: "overview-toggle#toggle", overview_toggle_target: "button" }) %>
      </div>
      <div class="min-w-0 md:flex-1 md:basis-96 md:max-w-xl">
        <%= render "transactions/searches/search" %>
      </div>
    </div>
    <div id="transaction-summary" class="hidden mb-4" data-overview-toggle-target="panel">
      <%= render "summary", totals: @search.totals %>
    </div>
    <%= render "transactions/list", transactions: @transactions, projected_recurring: @projected_recurring, q: params[:q], pagy: @pagy %>
    <div class="pt-4">
      <%= render "shared/pagination", pagy: @pagy, per_page_options: [ 30, 50, 200, 500 ] %>
    </div>
  <% else %>
    <div class="[&_[role=tabpanel]:focus]:outline-none [&_[role=tabpanel]:focus]:ring-0">
      <%= render DS::Tabs.new(active_tab: params[:tab].presence || "transactions") do |tabs| %>
      <% tabs.with_nav(classes: "max-w-fit whitespace-nowrap") do |nav| %>
        <% nav.with_btn(id: "transactions", label: t("transactions.show.tab_transactions"), classes: "px-6 whitespace-nowrap") %>
        <% nav.with_btn(id: "upcoming", label: t("transactions.show.tab_upcoming"), classes: "px-6 whitespace-nowrap") %>
      <% end %>

      <% tabs.with_panel(tab_id: "transactions") do %>
        <div class="mb-4 flex flex-wrap items-start justify-between gap-3 [&_#transaction-search-filters]:mb-0 [&_#transactions-search>div]:mb-0">
          <div class="flex shrink-0 items-center gap-2">
            <%= render DS::Button.new(id: "toggle-checkboxes-button", text: t("transactions.searches.form.select", default: "选择"), type: "button", variant: "outline", icon: "list-todo", class: "[&>span]:hidden lg:[&>span]:inline-flex", data: { action: "click->checkbox-toggle#toggle", checkbox_toggle_target: "toggleButton" }) %>
            <%= render DS::Button.new(id: "transaction-summary-button", text: t("transactions.show.summary", default: "概览"), type: "button", variant: "outline", icon: "chart-no-axes-column", class: "[&>span]:hidden lg:[&>span]:inline-flex", aria: { controls: "transaction-summary", expanded: "false" }, data: { action: "overview-toggle#toggle", overview_toggle_target: "button" }) %>
          </div>
          <div class="min-w-0 md:flex-1 md:basis-96 md:max-w-xl">
            <%= render "transactions/searches/search" %>
          </div>
        </div>
        <div id="transaction-summary" class="hidden mb-4" data-overview-toggle-target="panel">
          <%= render "summary", totals: @search.totals %>
        </div>
        <div class="bg-container rounded-xl overflow-hidden shadow-border-xs focus:outline-none focus:ring-0 focus-within:outline-none focus-within:ring-0">
          <%= render "transactions/list", transactions: @transactions, projected_recurring: @projected_recurring, q: params[:q], pagy: @pagy %>
        </div>
        <div class="pt-4">
          <%= render "shared/pagination", pagy: @pagy, per_page_options: [ 30, 50, 200, 500 ] %>
        </div>
      <% end %>

      <% tabs.with_panel(tab_id: "upcoming") do %>
        <div class="bg-container rounded-xl shadow-border-xs">
          <%= render "transactions/upcoming" %>
        </div>
      <% end %>
      <% end %>
    </div>
  <% end %>
</div>
