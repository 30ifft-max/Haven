<%# locals: (entry:, transaction:, show_split: true) %>
<div class="hidden lg:flex w-full items-center justify-end gap-1 whitespace-nowrap pr-1 text-secondary">
  <div class="order-2 flex size-6 shrink-0 items-center justify-center">
    <% if transaction.tags.any? %>
      <% tags_tooltip_id = dom_id(entry, "tags-tooltip") %>
      <span data-controller="DS--tooltip" data-DS--tooltip-placement-value="left" data-DS--tooltip-offset-value="10" class="inline-flex">
        <button type="button" class="inline-flex size-5 items-center justify-center rounded focus-ring" aria-describedby="<%= tags_tooltip_id %>">
        <% tags = transaction.tags.first(4) %>
        <% if tags.one? %>
          <span class="flex items-center justify-center">
            <span class="size-1.5 rounded-full" style="background-color: <%= tags.first.color.presence || "var(--color-primary)" %>"></span>
          </span>
        <% elsif tags.size == 2 %>
          <span class="flex items-center justify-center gap-0.5">
            <% tags.each do |tag| %>
              <span class="size-1.5 rounded-full" style="background-color: <%= tag.color.presence || "var(--color-primary)" %>"></span>
            <% end %>
          </span>
        <% elsif tags.size == 3 %>
          <span class="grid grid-cols-2 gap-0.5">
            <span class="col-span-2 justify-self-center size-1.5 rounded-full" style="background-color: <%= tags[0].color.presence || "var(--color-primary)" %>"></span>
            <% tags.drop(1).each do |tag| %>
              <span class="size-1.5 rounded-full" style="background-color: <%= tag.color.presence || "var(--color-primary)" %>"></span>
            <% end %>
          </span>
        <% else %>
          <span class="grid grid-cols-2 gap-0.5">
            <% tags.each do |tag| %>
              <span class="size-1.5 rounded-full" style="background-color: <%= tag.color.presence || "var(--color-primary)" %>"></span>
            <% end %>
          </span>
        <% end %>
        </button>
        <div role="tooltip" id="<%= tags_tooltip_id %>" data-DS--tooltip-target="tooltip" class="hidden absolute z-50 rounded-xl bg-surface px-3 py-2 text-sm shadow-lg">
          <div class="relative space-y-1.5 font-medium text-primary">
            <% transaction.tags.each do |tag| %>
              <div class="flex items-center gap-2 whitespace-nowrap">
                <span class="size-3 shrink-0 rounded-full" style="background-color: <%= tag.color.presence || Tag::UNCATEGORIZED_COLOR %>"></span>
                <span><%= tag.name %></span>
              </div>
            <% end %>
          </div>
        </div>
      </span>
    <% end %>
  </div>

  <div class="order-3 mr-2 flex size-6 shrink-0 items-center justify-center">
    <% if entry.notes.present? %>
      <% notes_tooltip_id = dom_id(entry, "notes-tooltip") %>
      <span data-controller="DS--tooltip" data-DS--tooltip-placement-value="top" data-DS--tooltip-offset-value="10" class="inline-flex">
        <button type="button" class="inline-flex size-5 items-center justify-center rounded focus-ring" aria-describedby="<%= notes_tooltip_id %>"><%= icon "message-square-text", size: "sm", color: "current" %></button>
        <div role="tooltip" id="<%= notes_tooltip_id %>" data-DS--tooltip-target="tooltip" class="hidden absolute z-50 max-w-[20rem] rounded-xl bg-surface px-3 py-2 text-sm shadow-lg">
          <div class="relative whitespace-pre-wrap font-medium text-primary"><%= entry.notes.truncate(200) %></div>
        </div>
      </span>
    <% end %>
  </div>

  <div class="order-1 flex size-6 shrink-0 items-center justify-center">
    <% if entry.protected_from_sync? && !entry.excluded? %>
      <%= link_to entry_path(entry),
          data: { turbo_frame: "drawer", turbo_prefetch: false },
          title: t("entries.protection.tooltip"),
          class: "inline-flex size-5 items-center justify-center rounded focus-ring" do %>
        <%= icon "lock", size: "sm", class: "text-secondary" %>
      <% end %>
    <% end %>
  </div>
</div>
