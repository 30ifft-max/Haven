<%# locals: (date:, entries:, content:, totals: false) %>

<div id="entry-group-<%= date %>" class="w-full" data-bulk-select-target="group">
  <div class="bg-container-inset py-2 px-4 flex items-center justify-between font-medium text-sm text-secondary">
    <div class="flex pl-0.5 items-center gap-4">
      <p class="uppercase space-x-1.5">
        <%= tag.span I18n.l(date, format: :long) %>
        <span>·</span>
        <%= tag.span entries.size %>
      </p>
    </div>

    <% if totals %>
      <div id="entry-group-<%= date %>-totals" class="privacy-sensitive">
        <%= totals_by_currency(collection: entries, money_method: :amount_money, negate: true) %>
      </div>
    <% end %>
  </div>
  <div class="[&>turbo-frame:not(:last-child)>turbo-frame>div]:border-b-[0.5px] [&>turbo-frame:not(:last-child)>turbo-frame>div]:border-[var(--color-container-inset)]">
    <%= content %>
  </div>
</div>
