<%# locals: (accounts:) %>

<% ActiveRecord::Associations::Preloader.new(records: accounts, associations: [ :account_shares, :accountable, :plaid_account, :simplefin_account, { account_providers: :provider }, { logo_attachment: :blob } ]).call %>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <% { "asset" => Accountable::TYPES.select { |type| Accountable.from_type(type).classification == "asset" }, "liability" => Accountable::TYPES.select { |type| Accountable.from_type(type).classification == "liability" } }.each do |classification, types| %>
    <section class="space-y-3">
      <h2 class="text-sm font-medium text-primary"><%= t(".#{classification}_accounts") %></h2>
      <div class="space-y-3">
        <% types.each do |accountable_type| %>
          <%= render "accounts/index/account_type_card", accountable_type: accountable_type, accounts: accounts.select { |account| account.accountable_type == accountable_type } %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
