<%= link_to t("rules.index.page_title"), rules_path %>

<%= render DS::Dialog.new do |dialog| %>
  <% resource_label = t("rules.resources.#{@rule.resource_type}", default: @rule.resource_type.humanize) %>
  <% dialog.with_header(title: t("rules.new.title", resource: resource_label)) %>
  <% dialog.with_body do %>
    <%= render "rules/form", rule: @rule %>
  <% end %>
<% end %>
